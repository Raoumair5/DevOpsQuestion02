pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/Raoumair5/DevOpsQuestion02.git',
                    branch: 'dev'
            }
        }

        stage('Run Tests') {
            steps {
                // Execute test script using cmd
                bat 'test.bat'
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: '**/*.html, **/*.css, **/*.js', excludes: '*.git*'
            }
        }
    }

    post {
        success {
            echo 'Build successful! All artifacts have been archived.'
        }
        failure {
            echo 'Build failed. Check the console output for errors.'
        }
    }
}
