pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/Raoumair5/DevOpsQuestion02.git',
                    branch: 'dev'
            }
        }

        stage('Install Dependencies') {
            steps {
                // Use bat to run commands compatible with Windows
                bat 'npm install'
                // For Python projects, use:
                // bat 'pip install -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                // Execute test script using cmd
                bat 'test.bat'
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'website/**/*', excludes: '*.git*'
            }
        }
    }

    post {
        success {
            echo 'Build successful! Artifacts have been archived.'
        }
        failure {
            echo 'Build failed. Check the console output for errors.'
        }
    }
}
