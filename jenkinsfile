pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/Raoumair5/DevOpsQuestion02.git',
                    branch: 'dev'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'pip install --user --upgrade pip'
                sh 'pip install --user -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                sh './test.sh'  // Run your test script
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'website/**/*', excludes: '*.git*'
            }
        }
    }

    post {
        success {
            echo 'Build successful! Artifacts have been archived.'
        }
        failure {
            echo 'Build failed. Check the console output for errors.'
        }
    }
}